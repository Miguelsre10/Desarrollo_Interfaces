<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UD3_PERISTENCIA_MAUI.MainPage">

    <ScrollView>

        <Grid BackgroundColor="LightBlue" Padding="20"
              RowDefinitions="Auto" ColumnDefinitions="*">
            <Border Stroke="Brown" StrokeThickness="2"
                StrokeShape="RoundRectangle 10" BackgroundColor="White">

                <VerticalStackLayout Spacing="5">


                    <Label Text="Agencia de Viajes"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           FontSize="Medium"
                           Margin="0,20,0,0"
                           />
                    
                    <!-- Nombre del cliente -->
                    <Label Text="Nombre:"                          
                           FontSize="Small"
                           />

                    <Entry x:Name="EntryClientName"
                           Placeholder="Escribe tu nombre"
                           />
                    
                    <!-- Nombre del cliente -->
                    <Label Text="Email:"                          
                           FontSize="Small"
                           />

                    <Entry x:Name="EntryClientMail"
                           Placeholder="email@example.com"
                           Keyboard="Email"
                           />
                    
                    

                </VerticalStackLayout>

            </Border>
            
            
        </Grid>
        
    </ScrollView>

</ContentPage>
