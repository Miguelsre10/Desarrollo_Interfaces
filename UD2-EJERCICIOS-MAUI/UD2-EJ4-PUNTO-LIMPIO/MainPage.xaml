<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UD2_EJ4_PUNTO_LIMPIO.Models"
             xmlns:views="clr-namespace:UD2_EJ4_PUNTO_LIMPIO"
             x:Class="UD2_EJ4_PUNTO_LIMPIO.MainPage"
             x:DataType="views:MainPage">

    <ScrollView>
        <VerticalStackLayout Padding=" 10"
                         Spacing="10">

            <Border StrokeShape="RoundRectangle 10"
                BackgroundColor="Coral"
                Stroke="OrangeRed"
                Padding="15">

                <VerticalStackLayout>

                    <!-- nombre residuo -->
                    <HorizontalStackLayout>
                        <Label Text="Nombre Residuo: "
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           />

                        <Entry x:Name="ResidueName" VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                    <!-- tipo residuo -->
                    <HorizontalStackLayout>
                        <Label Text="Tipo Residuo: "
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>

                        <Entry x:Name="ResidueType"/>

                    </HorizontalStackLayout>

                    <!-- cantidad -->
                    <HorizontalStackLayout>
                        <Label Text="Cantidad: "
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>

                        <Entry x:Name="ResidueAmount"
                           Keyboard="Numeric"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

            <Button Text="Agregar Residuo"
                TextColor="White"
                VerticalOptions="Center"
                x:Name="AddResidue"
                Clicked="AddResidue_Clicked"/>

            <Button Text="Eliminar Residuo"
                TextColor="White"
                VerticalOptions="Center"
                x:Name="RemoveResidue"
                Clicked="RemoveResidue_Clicked"
                />

            <!-- Lista de residuos -->
            <Label Text="Listado de Residuos" FontAttributes="Bold" FontSize="24"/>

            <CollectionView x:Name="listaResiduos"
                ItemsSource="{Binding Residuos}"
                SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Residuo">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Column="0" Text="{Binding Nombre}"/>
                            <Label Grid.Column="1" Text="{Binding Tipo}"/>
                            <Label Grid.Column="2" Text="{Binding Cantidad}"/>
                        </Grid>
                    </DataTemplate>

                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="TotalResiduos"
                   Text="Cantidad de residuos: 0"
                   FontAttributes="Bold"
                   FontSize="18"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
