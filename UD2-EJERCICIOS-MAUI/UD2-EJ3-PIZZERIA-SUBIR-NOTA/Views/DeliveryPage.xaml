<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UD2_EJ3_PIZZERIA_SUBIR_NOTA.Views.DeliveryPage"
             xmlns:views="clr-namespace:UD2_EJ3_PIZZERIA_SUBIR_NOTA.Views"
             xmlns:models="clr-namespace:UD2_EJ3_PIZZERIA_SUBIR_NOTA.Models"
             x:DataType="views:DeliveryPage"
             Title="Confirmar tu pedido">
    
    <VerticalStackLayout Padding="20" BackgroundColor="LightYellow">
        <Image Source="delivery.jpg" HeightRequest="300" WidthRequest="300"/>

        <Label Text="Fecha de entrega de la pizza" Margin="0,20,0,0"/>
        <DatePicker x:Name="DateDelivery"/>
               
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="30">
            <Button 
                Text="Volver" 
                Margin="0,20,0,0"
                x:Name="BtnDelivery_volver"
                Clicked="BtnDelivery_volver_Clicked"/>

            <Button 
                Text="Confirmar" 
                Margin="0,20,0,0"
                x:Name="BtnDelivery_confirmar" 
                Clicked="BtnDelivery_confirmar_Clicked"
                />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>