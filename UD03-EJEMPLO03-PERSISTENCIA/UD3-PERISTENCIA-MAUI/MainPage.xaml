<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UD3_PERISTENCIA_MAUI.MainPage">

    <ScrollView>

        <Grid BackgroundColor="LightBlue" Padding="20"
              RowDefinitions="Auto" ColumnDefinitions="*">
            <Border Stroke="Brown" StrokeThickness="2" Padding="15"
                StrokeShape="RoundRectangle 10" BackgroundColor="White">

                <VerticalStackLayout Spacing="5">


                    <Label Text="Agencia de Viajes"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           FontSize="Medium"
                           Margin="0,20,0,0"
                           />
                    
                    <!-- Nombre del cliente -->
                    <Label Text="Nombre:"                          
                           FontSize="Small"
                           />

                    <Entry x:Name="EntryClientName"
                           Placeholder="Escribe tu nombre"
                           />
                    
                    <!-- Email del cliente -->
                    <Label Text="Email:"                          
                           FontSize="Small"
                           />

                    <Entry x:Name="EntryClientMail"
                           Placeholder="email@example.com"
                           Keyboard="Email"
                           />
                    
                    <!-- Destino del cliente -->
                    <Label Text="Destino Favorito:"                          
                           FontSize="Small"
                           />

                    <Picker x:Name="PickerDestiny">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Playa</x:String>
                                <x:String>Montaña</x:String>
                                <x:String>Ciudad</x:String>
                                <x:String>Aventura</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                        <!-- Presupuesto del viaje-->
                    <Label Text="Presupueto:"                          
                           FontSize="Small"
                           />

                    <Entry x:Name="EntryBudget"
                           Placeholder="500"
                           Keyboard="Numeric"
                           />
                    
                    <!-- Botones para guardar y cargar la configuracion -->
                    <Button x:Name="BtnSave" Text="GUARDAR" BackgroundColor="Green" WidthRequest="200"
                            TextColor="White" Margin="0,35,0,0" Clicked="BtnSave_Clicked"/>

                    <Button x:Name="BtnLoad" Text="CARGAR" BackgroundColor="Blue" WidthRequest="200"
                            TextColor="White" Margin="0,35,0,0" Clicked="BtnLoad_Clicked"/>

                    <Button x:Name="BtnDelete" Text="BORRAR" BackgroundColor="Red" WidthRequest="200"
                            TextColor="White" Margin="0,35,0,0" Clicked="BtnDelete_Clicked"/>

                </VerticalStackLayout>

            </Border>
            
            
        </Grid>
        
    </ScrollView>

</ContentPage>
