<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UD2_EJ6_PAGES_MAUI.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="15">

            <Label Text="Neumaticos" FontSize="Large"/>
            
            <ImageButton Source="neumaticos.jpg" Aspect="AspectFit" x:Name="IBtnTyre" Clicked="IBtnTyre_Clicked"/>

            <Label Text="Pedir Cita" FontSize="Large"/>
            
            <ImageButton Source="cita.jpg" Aspect="AspectFit" x:Name="IBtnDate" Clicked="IBtnDate_Clicked"/>

            <Label Text="contacto" FontSize="Large"/>

            <ImageButton Source="contacto.jpg" Aspect="AspectFit" x:Name="IBtnContact" Clicked="IBtnContact_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
